# ============================================================
# .NET / ASP.NET Core
# ============================================================
## Build outputs.
## Deliberately NOT scoped to a project directory: these must cover every project in
## the solution, including ones added later. Restored packages come from NuGet, so
## nothing under bin/ or obj/ ever belongs in the repository.
[Bb]in/
[Oo]bj/
[Oo]ut/
[Dd]ebug/
[Rr]elease/
publish/
artifacts/
MyVideoGameList.Server/wwwroot/

## SQLite database (runtime data)
*.db
*.db-shm
*.db-wal

## MSBuild generated files
*.cache
FileListAbsolute.txt

## NuGet
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json

## User-specific files
*.user
*.userosscache
*.suo
*.userprefs

## Rider / Resharper
.idea/
_ReSharper*/
*.DotSettings.user

## Test results
[Tt]est[Rr]esults/
coverage/
*.trx
*.coverage
*.coveragexml

## Secret / config overrides (never commit secrets)
MyVideoGameList.Server/appsettings.*.json
!MyVideoGameList.Server/appsettings.json
!MyVideoGameList.Server/appsettings.Development.json

# ============================================================
# Node / React / React Router
# ============================================================
node_modules/
dist/
dist-ssr/
build/
storybook-static/
*.local

## React Router framework mode: generated route types and the SSR build output.
## Regenerated by "npm run typecheck" / "npm run build".
.react-router/

## Logs
myvideogamelist.client/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

## Lock files (keep these — remove lines if you want to ignore them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================================
# Visual Studio / VS Code
# ============================================================
.vs/

## Note the trailing /* rather than /. Git cannot re-include a file whose parent
## directory is excluded, so ".vscode/" would make the negations below dead rules.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

## Diagnostic Reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ============================================================
# Operating system
# ============================================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# Environment / secrets
# ============================================================
.env
.env.*
!.env.example

# ============================================================
