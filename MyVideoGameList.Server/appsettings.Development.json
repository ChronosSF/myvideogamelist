{
  // Matches compose.yaml. These credentials reach a container on this machine only, so they
  // are committed on purpose: `docker compose up` then `dotnet run` works on a fresh checkout
  // with no setup step. This is not an exception to "secrets never go in appsettings" — there
  // is no secret here. Real credentials still come from user secrets and environment
  // variables (ADR 0005).
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=myvideogamelist;Username=mvgl;Password=localdev"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
