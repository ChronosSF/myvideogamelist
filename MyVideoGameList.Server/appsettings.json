{
  // Deliberately empty. A PostgreSQL connection string carries a password, so deployed
  // environments supply it as ConnectionStrings__DefaultConnection (see ADR 0005), and local
  // development gets a container-only one from appsettings.Development.json.
  // Starting without it fails immediately and loudly, which is the intent.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  // IGDB credentials are supplied at runtime, never committed.
  // Local development:  dotnet user-secrets set "Igdb:ClientId" "<id>"
  // Deployed:           environment variables Igdb__ClientId / Igdb__ClientSecret
  "Igdb": {
    "ClientId": "",
    "ClientSecret": ""
  },
  "ActivePlatforms": [
    { "Id": 6,   "Name": "PC (Windows)",   "Abbreviation": "PC" },
    { "Id": 34,  "Name": "Android",         "Abbreviation": "Android" },
    { "Id": 39,  "Name": "iOS",             "Abbreviation": "iOS" },
    { "Id": 48,  "Name": "PlayStation 4",   "Abbreviation": "PS4" },
    { "Id": 49,  "Name": "Xbox One",        "Abbreviation": "XONE" },
    { "Id": 130, "Name": "Nintendo Switch", "Abbreviation": "Switch" },
    { "Id": 167, "Name": "PlayStation 5",   "Abbreviation": "PS5" },
    { "Id": 169, "Name": "Xbox Series X|S", "Abbreviation": "XSX" },
    { "Id": 508, "Name": "Nintendo Switch 2", "Abbreviation": "Switch 2" }
  ],
  // Who, if anyone, is in front of this process. Off here because nothing is: `dotnet run`
  // serves the browser directly. A deployment behind a load balancer turns it on and names the
  // subnet the balancer sits in, because X-Forwarded-For from an unnamed source would let a
  // caller choose the address this app rate-limits and logs. Turning it on without a trust list
  // fails at startup rather than trusting everyone. ForwardLimit counts the proxies that append
  // to the header: a load balancer alone is 1, a CDN in front of it is 2.
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  // Where the Data Protection key ring lives - the keys behind the sign-in cookie and the review
  // cursor. Empty here because `dotnet run` keeps the default ring in the user profile, which
  // persists across restarts. A deployment sets ParameterPath to a Systems Manager Parameter Store
  // path, one per environment, so every task reads one ring and a deploy does not sign everyone
  // out. Outside Development a ring persisted nowhere is a startup failure unless
  // AllowEphemeralKeys says it is deliberate, which it is only for running the production image
  // on a developer machine. See ADR 0042.
  "DataProtection": {
    "ParameterPath": "",
    "AllowEphemeralKeys": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
