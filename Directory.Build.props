<Project>

  <!-- Every project in the repository, the CDK app's included, and the API image's build, whose
       Dockerfile copies this file in before it restores.

       NuGet's own audit, at restore, of every package a project resolves, direct and transitive, at
       every severity. The .NET 10 SDK already defaults to all three, and they are stated so that an SDK
       whose defaults differ cannot narrow the audit without a change here. A finding is a warning
       NU1901 to NU1904 in any build; CI's Dependency audit job makes it an error (ADR 0061). -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>

  <!-- A finding with a fixed version is answered by taking it: a parent bumped, or the package pinned
       in the project that resolves it, as the test projects pin System.Security.Cryptography.Xml. Only
       an advisory with no fixed version, judged not to reach anything here, is suppressed, by its URL,
       with the reason and the issue that will remove the line:

         <ItemGroup>
           <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xxxx-xxxx-xxxx" />
         </ItemGroup>

       None is suppressed today. -->

</Project>
