<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Roll forward to future major versions of the netcoreapp as needed -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned exactly: a floating range would let a later restore change the synthesised
         templates with no change to the source, and Dependabot bumps them on purpose. -->
    <PackageReference Include="Amazon.CDK.Lib" Version="2.273.0" />
    <PackageReference Include="Constructs" Version="10.8.1" />

    <!-- jsii Roslyn analyzers (un-comment to obtain compile-time checks for missing required props
    <PackageReference Include="Amazon.Jsii.Analyzers" Version="*" PrivateAssets="all" />
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- The CloudFront Function's source, read at synthesis from beside the built assembly rather
         than from a working directory nobody controls. -->
    <None Include="functions\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The holding page's files (ADR 0066), copied beside it as holding\ for the same reason, and
         uploaded to the bucket from there exactly as they are. -->
    <None Include="..\..\..\holding\site\**" LinkBase="holding" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the migration task's sessions are told to wait for (ADR 0079), compiled from the API's
         own source rather than copied, so that the integration suite proves the string this app
         deploys. Only that file: its other half needs Npgsql, which this app does not have. -->
    <Compile Include="..\..\..\MyVideoGameList.Server\Data\SessionLimits.cs" Link="SessionLimits.cs" />
    <!-- The address every email is from, which the production account's sending role allows and no
         other (ADR 0088): the API's own constant, so the two cannot drift. -->
    <Compile Include="..\..\..\MyVideoGameList.Server\Services\Email\EmailIdentity.cs" Link="EmailIdentity.cs" />
  </ItemGroup>

</Project>
